# commerce-intel 환경변수 (D73 — 토큰 읽기/쓰기 분리)
#
# 이 파일을 ~/.config/intel/env 로 복사하고 실제 값을 채운다:
#   mkdir -p ~/.config/intel && cp docs/env.example ~/.config/intel/env
#   chmod 600 ~/.config/intel/env
#
# 실제 토큰 값은 레포에 절대 커밋하지 않는다 — 관리자에게 따로 받는다.
# 발급 절차: docs/TURSO-SETUP.md (turso db tokens create — 읽기용은 --read-only)
#
# 사용처:
#   INTEL_DB_TOKEN        읽기 전용 — 조회·EDA·분석. 팀원에게 배포해도 되는 토큰
#   INTEL_DB_WRITE_TOKEN  쓰기 — 수집 적재·insights 저장·편집·시트 미러 진행점.
#                         파이프라인을 돌리는 머신에만 둔다
# 스크립트는 쓰기 토큰이 있으면 그걸 쓰고, 없으면 읽기 토큰으로 연다
# (schema_v3.pick_token — 읽기 토큰만 가진 환경은 자동으로 읽기 전용이 된다).

export INTEL_DB_URL="libsql://<db-name>-<org>.turso.io"
export INTEL_DB_TOKEN="<읽기 전용 토큰>"
export INTEL_DB_WRITE_TOKEN="<쓰기 토큰>"
