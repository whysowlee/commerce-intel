.DS_Store
node_modules/
.env
.env.*
dist/
build/
tests/.work/
# 수집 데이터는 추적하지 않지만 data/.tools의 수집기·카탈로그는 인프라라 추적한다
# (`data/`로 통째로 제외하면 git이 폴더 안으로 내려가지 않아 예외가 안 먹는다 → `data/*`)
data/*
!data/.tools/
data/.tools/*.log
output/
# package.sh가 정본에서 떼어 만드는 배포용 seed DB — 생성물이라 추적하지 않는다 (D58).
# 정본 데이터를 git에 올리지 않는다는 규칙이 여기에도 그대로 적용된다
skills/commerce-intel/assets/seed-intel.db
description.md
__pycache__/
*.pyc
.venv/

# 브라우저 도구 부산물
.playwright-mcp/
musinsa-sweep-rest.json
.claude/settings.local.json
